{
  "name": "anni/lucky-wheel-server",
  "description": "ANNI Lucky Wheel API and same-origin frontend",
  "type": "project",
  "license": "proprietary",
  "require": {"php": "^8.3", "laravel/framework": "^13.0", "ext-pdo": "*", "ext-pdo_mysql": "*", "ext-mbstring": "*", "ext-gd": "*"},
  "require-dev": {
    "laravel/pint": "^1.0",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"test": "phpunit", "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]},
  "config": {"optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist", "allow-plugins": {}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
