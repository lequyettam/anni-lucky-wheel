APP_NAME="ANNI Lucky Wheel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://game.annicoffeecamau.com
APP_TIMEZONE=UTC
LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_anni_game
DB_USERNAME=cpaneluser_anni_game
DB_PASSWORD=
DB_SOCKET=
# Use a trusted CA if MariaDB is on another host. Do not expose port 3306 publicly.
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_COOKIE=anni_game_session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync

# No browser-accessible database configuration. No public admin bootstrap endpoint.
ANNI_STAFF_SESSION_HOURS=8
ANNI_CUSTOMER_SESSION_DAYS=30
